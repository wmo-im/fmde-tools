[[source]]
url = "https://pypi.python.org/simple"
verify_ssl = true
name = "firstmile-proto"

[scripts]
build-proto = "bash -c 'mkdir -p protospy && python -m grpc_tools.protoc --experimental_allow_proto3_optional --proto_path=../../schemas --python_out=protospy/ ../../schemas/first-mile-message-encoding.proto'"

[packages]
protobuf = "*"
grpcio-tools = "*"
paho-mqtt = "*"
dash = "*"
dash-bootstrap-components = "*"
plotly = "*"
pandas = "*"

[dev-packages]
